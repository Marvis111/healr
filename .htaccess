# Enable rewrite engine
RewriteEngine On

# Make index.html the default homepage
DirectoryIndex index.html

# Redirect /index or /index.html → /
RewriteRule ^index$ / [R=301,L]
RewriteRule ^index\.html$ / [R=301,L]

# Route /doctor/{uid}/profile to /doctor/profile.html (preserve URL for JS to read)
RewriteRule ^doctor/([a-zA-Z0-9-]+)/profile/?$ doctor/profile.html [L]

# If URL has no extension, but .html file exists → serve it
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Redirect .html URLs to extensionless
RewriteCond %{THE_REQUEST} \s/([^.]+)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]